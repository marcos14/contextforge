# ============== Core ==============
# 32-byte master key encoded in base64 (used to derive DEKs via HKDF)
# Generate with: openssl rand -base64 32
MASTER_KEY=CHANGE_ME_BASE64_32BYTES

# JWT signing secret for the admin UI (>= 32 bytes recommended)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ============== Server ==============
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
# Comma-separated origins, or * (cannot combine * with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============== Docker Compose port mapping ==============
# Host ports exposed by docker-compose. Container ports are fixed by the images
# (postgres=5432, redis=6379) except for the app, which honors HTTP_ADDR — set
# CONTEXTFORGE_CONTAINER_PORT to match the port in HTTP_ADDR above.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
CONTEXTFORGE_HOST_PORT=8080
CONTEXTFORGE_CONTAINER_PORT=8080
CONTEXTFORGE_ORACLE_HOST_PORT=8081

# ============== Frontend dev server (Vite) ==============
# Port the Vite dev server listens on, and backend URL used for /api and /mcp proxy.
VITE_DEV_PORT=5173
VITE_BACKEND_URL=http://localhost:8080

# ============== Postgres (metadados) ==============
DATABASE_URL=postgres://contextforge:contextforge@postgres:5432/contextforge?sslmode=disable

# ============== Redis (cache + rate limit) ==============
REDIS_URL=redis://redis:6379/0

# ============== Registry refresh (in-memory tool registry) ==============
REGISTRY_REFRESH_SECONDS=5

# ============== Tool execution defaults ==============
# Maximum rows returned per tool execution (default: 1000).
TOOL_DEFAULT_ROW_LIMIT=1000

# ============== Rate limit (global ceiling per IP, req/min) ==============
RATE_LIMIT_IP_PER_MIN=600

# ============== LLM (OpenRouter) ==============
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OPENROUTER_MODEL=xiaomi/mimo-v2.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60

# ============== Bootstrap admin (created on first run if no users exist) ==============
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ============== Observability ==============
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=contextforge
METRICS_ENABLED=true
